PANEL = 'enveda-075b-external-massbank-adducts'


def heldout_groups(describe):
    labels = pd.read_parquet(find(PANEL, 'labels.parquet'))
    descriptions = [describe(row.truth_smiles, scaffold=True) for row in labels.itertuples(index=False)]
    if any(item is None for item in descriptions):
        raise ValueError('Could not derive every external identity and scaffold.')
    keys = set(labels.candidate_id) | {item[0] for item in descriptions}
    scaffolds = {item[1] for item in descriptions} - {''}
    return keys, scaffolds


def pan_family():
    from rdkit import Chem

    repeat = Chem.MolFromSmarts('[C;!R]([C]#[N])[C;!R][C;!R]([C]#[N])')
    sulfonate = Chem.MolFromSmarts('[C;!R][S](=[O])(=[O])[O;H1,-1]')

    def contains(smiles):
        molecule = Chem.MolFromSmiles(smiles)
        return molecule is not None and molecule.HasSubstructMatch(repeat) and molecule.HasSubstructMatch(sulfonate)

    return contains
