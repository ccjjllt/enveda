import json
from functools import lru_cache as _negative_cache


# Inside the original C34 worker, after scoring the original pool.
def _insert_negative_window(mid, target, smis, pop, fz, z, out, out_s, out_k, out_p,
                            out_sc, promotion_evidence):
    path = os.environ['NEGATIVE_WINDOW_PROPOSALS']
    request = _negative_proposals(path).get(str(mid))
    if request is None:
        return None
    if abs(request['target'] - target) > 1e-6:
        raise ValueError(f'Mismatched measured neutral mass for {mid}')
    chemistry, bits = _W['chem'], _W['bits']
    by_smiles = {}
    for i, smiles in enumerate(smis):
        by_smiles.setdefault(smiles, i)
    # The original leader and the inherited gate evidence are fixed at C34.
    budget = min(5, max(0, len(out) - 1))
    inserted = []
    inserted_keys = []
    keys = set(out_k)
    mean, std = fz.mean(), fz.std() + 1e-9
    for proposal in request['entries']:
        if len(inserted) == budget:
            break
        smiles = proposal['smiles']
        if smiles not in by_smiles:
            raise ValueError(f'Candidate outside the rechecked mass window for {mid}')
        key = chemistry.score_key(smiles)
        if not key or key in keys or key in _W['pool_keys']:
            continue
        fp = chemistry.raw_fingerprint(smiles)
        if fp is None:
            continue
        prior = float(pop[by_smiles[smiles]])
        raw = float(fp[bits].astype(np.float32) @ z)
        score = float((raw-mean) / std + _POP_LAM * prior)
        if not np.isfinite(score):
            continue
        keys.add(key)
        inserted.append((smiles, score, key, prior))
        inserted_keys.append(proposal['key'])
        promotion_evidence[key] = dict(smiles=smiles, raw_fz=raw, S=score, pop=prior)
    if inserted:
        budgeted = list(zip(out, out_s, out_k, out_p, strict=True))[:-len(inserted)]
        budgeted = budgeted[:1] + sorted(budgeted[1:] + inserted, key=lambda row: -row[1])
        out[:], out_s[:], out_k[:], out_p[:] = map(list, zip(*budgeted, strict=True))
        out_sc[:] = out_s
    return {'size': len(out), 'inserted': inserted_keys}


@_negative_cache(maxsize=1)
def _negative_proposals(path):
    with open(path) as source:
        return json.load(source)
