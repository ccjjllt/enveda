"""Rescore already ranked E1 candidates with the two stock forward score maps."""

def native_only_route(stock, baseline, deep, ice_scores, gl_scores, real_h_ids, proxy_ids, rerank_multi, library_cutoff):
    import math
    from collections import Counter

    if set(stock) != set(baseline) or set(deep) - set(stock):
        raise ValueError('Native-only E1 ledgers cover different queries')
    revised = {}
    audit = Counter()
    for mid, (smiles, keys, library, scalar, formulas) in stock.items():
        original = baseline[mid]
        if (list(original[0]) != list(smiles[:25]) or list(original[1]) != list(keys[:25])
                or original[2] != library or not math.isfinite(library)):
            raise ValueError('Unexpected stock pre-C43 E1 ordering')
        overflow = deep.get(mid, ())
        audit['main_entries'] += len(smiles)
        audit['retained_scalar_entries_61_to_100'] += len(overflow)
        if mid in proxy_ids:
            audit['kept_stock_proxy_or_proxy_eligible'] += 1
            continue
        if library >= library_cutoff:
            audit['kept_stock_strong_library_match'] += 1
            continue
        if not smiles or mid not in real_h_ids:
            audit['kept_stock_no_native_protonated_spectrum'] += 1
            continue
        branch = [ice_scores.get(str(mid), {}), gl_scores.get(str(mid), {})]
        if not all(any(value is not None and math.isfinite(value) for value in model.values()) for model in branch):
            audit['kept_stock_missing_native_model_evidence'] += 1
            continue
        slate_smiles = [*smiles, *(row[0] for row in overflow)]
        slate_keys = [*keys, *(row[1] for row in overflow)]
        slate_scores = [*scalar, *(row[2] for row in overflow)]
        slate_formulas = [*formulas, *(row[3] for row in overflow)]
        if (len({len(slate_smiles), len(slate_keys), len(slate_scores), len(slate_formulas)}) != 1
                or not 0 < len(slate_smiles) <= 100 or len(set(slate_keys)) != len(slate_keys)
                or not all(math.isfinite(v) for v in slate_scores)):
            raise ValueError('Inconsistent cached E1 scalar ordering or keys')
        order = rerank_multi(slate_smiles, slate_keys, slate_scores, slate_formulas, branch, [1.,1.], top_n=len(slate_smiles))
        if sorted(order) != list(range(len(slate_smiles))):
            raise ValueError('Unexpected native-only reranking permutation')
        selected = order[:len(original[0])]
        item = ([slate_smiles[i] for i in selected], [slate_keys[i] for i in selected], library)
        revised[mid] = item
        audit['reranked_queries'] += 1
        audit['changed_main'] += item[0] != list(original[0])
        audit['changed_main_top1'] += item[0][:1] != list(original[0])[:1]
        audit['changed_main_top5'] += item[0][:5] != list(original[0])[:5]
        audit['positions_filled_from_c39_overflow'] += sum(i >= len(smiles) for i in selected)
    return revised, dict(audit)


def native_only_apply(stock, baseline, deep, ice_scores, gl_scores, ice_items, gl_items, proxy_ids, reranker, library_cutoff):
    import hashlib
    import json
    from pathlib import Path
    import time

    started = time.monotonic()
    root = Path('/kaggle/working')
    report = dict(status='kept_stock', queries=len(baseline), added_model_requests=0, new_candidate_generation=0,
                  c34_public_stock=True, library_max_threshold=library_cutoff,
                  native_gl_adduct='[M+H]+', proxy_route='original_v29', unsupported_single_model_route='original_v29',
                  c39_scalar_depth=100, final_e1_cap=25)
    routed = {}
    try:
        if library_cutoff != .9 or reranker is None:
            raise ValueError('No compatible stock C41 reranker')
        helper = Path(reranker.__file__)
        if hashlib.sha256(helper.read_bytes()).hexdigest() != 'ea390f5f29705c015f39c509cc2b86e6a360d0bb90db61c87c507068f38ae58e':
            raise ValueError('Stock GLACIER reranker differs from the archived research implementation')
        models = report['unchanged_stock_model_inputs'] = {}
        for model, rows, scores in (('ice',ice_items,ice_scores),('gl',gl_items,gl_scores)):
            row = models[model] = dict(requested_molecules=len(rows), requested_candidate_spectra=sum(len(r['cands'])*len(r['spectra']) for r in rows),
                                       returned_molecules=len(scores))
            if rows:
                metadata = json.loads((root/(model+'_work')/(model+'_out.json.meta.json')).read_bytes())
                row.update(status=metadata.get('status'), device=metadata.get('device'))
                if metadata.get('status') != 'ok' or not str(metadata.get('device','')).startswith('cuda'):
                    raise ValueError('Stock '+model+' score map is incomplete or not from CUDA')
        real_h_ids = {r['mid'] for r in gl_items if any(s.get('adduct')=='[M+H]+' and s.get('mode')=='positive' for s in r['spectra'])}
        routed, counts = native_only_route(stock,baseline,deep,ice_scores,gl_scores,real_h_ids,proxy_ids,reranker.rerank_multi,library_cutoff)
        report.update(status='applied_native_only', route_counts=counts, stock_proxy_molecules=len(proxy_ids))
    except Exception as error:
        report.update(reason=f'{type(error).__name__}: {error}')
    final = {str(mid):list(routed.get(mid,row)[0]) for mid,row in baseline.items()}
    report['routed_main_sha256'] = hashlib.sha256(json.dumps(final,sort_keys=True,separators=(',',':'),ensure_ascii=False).encode()).hexdigest()
    report['elapsed_seconds'] = round(time.monotonic()-started, 3)
    temp = root/'native_only_c41_audit.tmp'
    temp.write_text(json.dumps(report,indent=2,allow_nan=False)+'\n')
    temp.replace(root/'native_only_c41_audit.json')
    baseline.update(routed)
    print('Native-only C41:',report['status'],report.get('route_counts',{}),flush=True)
